# =============================================================
#  Inception - environment variables (template)
#
#  `make` copies this file to srcs/.env, which is NOT versioned.
#  No password belongs here: every credential lives in secrets/
#  and is mounted into the containers as a Docker secret.
# =============================================================

# ---- Host / domain -----------------------------------------
DOMAIN_NAME=mobullad.42.fr
DATA_PATH=/home/mobullad/data

# ---- MariaDB (names only, no password) ---------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# ---- WordPress ---------------------------------------------
WORDPRESS_DB_HOST=mariadb
WP_TITLE=Inception

# Administrator login. The subject forbids any name containing
# "admin" or "administrator".
WP_ADMIN_USER=bossman
WP_ADMIN_EMAIL=bossman@student.42.fr

# Second, non-privileged user (role: author)
WP_USER=morgan
WP_USER_EMAIL=morgan@student.42.fr
